# xorv-landing — copy to .env.local (on Vercel: Project Settings → Environment
# Variables). Every value is optional and inlined at build time, so changing
# one means rebuilding/redeploying. This site never reads the repo-root .env.

# Canonical origin for metadata, Open Graph and JSON-LD. Unset on Vercel = the
# project's production domain (VERCEL_PROJECT_PRODUCTION_URL, which Vercel
# provides); unset elsewhere = http://localhost:3000.
NEXT_PUBLIC_XORV_SITE_URL=
# Public broker the live ledger section reads (/api/network, /api/receipts,
# /api/leaderboard). The broker's XORV_CORS_ORIGINS must include this origin.
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
# The buyer app every "Post a job" / "Launch app" link opens.
NEXT_PUBLIC_XORV_APP_URL=http://localhost:3002
# Arc testnet (default, chain 5042002) or mainnet (chain 5042):
# eip155:5042002 | eip155:5042
NEXT_PUBLIC_XORV_NETWORK=eip155:5042002
# Optional explorer override (default: Arc's Blockscout for the network above,
# https://explorer.testnet.arc.io or https://explorer.arc.io).
NEXT_PUBLIC_XORV_EXPLORER_URL=
# Deployed Xorv contracts (deployments/arc-<network>.json), for the contract
# links in the ledger section and footer. The live section prefers whatever the
# broker's /api/network reports. Unset = the site links no contract rather
# than invent one.
NEXT_PUBLIC_XORV_ESCROW_ADDRESS=
NEXT_PUBLIC_XORV_REPUTATION_ADDRESS=
NEXT_PUBLIC_XORV_LEDGER_ADDRESS=
