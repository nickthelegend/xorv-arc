# xorv-app — copy to .env.local (on Vercel: Project Settings → Environment
# Variables). NEXT_PUBLIC_* values are inlined at build time, so changing one
# means rebuilding/redeploying. This app never reads the repo-root .env.

# The broker the browser talks to (quotes, jobs, x402 payments, ratings). The
# broker's XORV_CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
# Arc testnet (default) or mainnet: eip155:5042002 | eip155:5042
NEXT_PUBLIC_XORV_NETWORK=eip155:5042002
# Optional browser RPC (default https://rpc.testnet.arc.io); public RPCs are rate-limited per IP.
NEXT_PUBLIC_XORV_RPC_URL=
# Optional RPC for the live Arc strip (block interval, finality, gas in USDC).
# Always the real network, even when NEXT_PUBLIC_XORV_RPC_URL points at a local fork.
NEXT_PUBLIC_XORV_LIVE_RPC_URL=

# Privy (https://dashboard.privy.io). With an app id, visitors log in with
# email / Google / passkey / wallet and get an embedded wallet that pays for
# jobs and signs ratings. Without one, the app falls back to an injected
# browser wallet (window.ethereum) plus the demo account below. Add the
# deployed origin to the Privy app's allowed domains.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional Privy app client id (Dashboard → App settings → Clients).
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# --- server-only (never exposed to the browser) ---------------------------
# Demo account for "Pay from demo account" (testnet only; refused on mainnet).
# A raw 32-byte secp256k1 key holding test USDC on Arc Testnet (https://faucet.circle.com).
# On Arc USDC is also the gas token, but the demo account never pays gas: it only signs.
XORV_DEMO_PAYER_KEY=
# Largest job the demo account will pay for, in USDC units (6 dp). Default 500000 = $0.50.
XORV_DEMO_MAX_USDC_UNITS=
# Server-side broker URL / network, if they differ from the public ones.
XORV_BROKER_URL=
XORV_NETWORK=
# The server routes also honour the chain overrides described in the root
# .env.example (XORV_RPC_URL, XORV_EXPLORER_URL, XORV_STABLECOIN*); leave them
# unset unless the broker sets them too.
