{
  "name": "xorv",
  "version": "0.2.0",
  "private": true,
  "description": "Xorv \u2014 a decentralized AI capacity network on Arc. Rent out your idle Claude/Codex/Qwen/Kimi capacity and get paid per job in USDC over x402, through an on-chain escrow that writes every outcome to ERC-8004 reputation; fund from any chain with Circle Gateway or Chainlink CCIP, withdraw anywhere with CCTP V2.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/xorv-arc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/xorv-arc.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./services/** build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=./packages/** --filter=./services/** --filter=xorv-app --filter=xorv-landing test",
    "e2e": "pnpm --filter @xorv/e2e e2e",
    "demo": "pnpm --filter @xorv/e2e demo",
    "broker": "pnpm --filter @xorv/broker dev",
    "broker:start": "pnpm --filter @xorv/broker start",
    "app": "pnpm --filter xorv-app dev",
    "landing": "pnpm --filter xorv-landing dev",
    "cli": "pnpm --filter @xorv/cli dev",
    "mcp": "pnpm --filter @xorv/mcp dev",
    "privy:setup": "pnpm --filter @xorv/mcp privy:setup",
    "usdc": "pnpm --filter @xorv/broker usdc",
    "e2e:arc": "pnpm --filter @xorv/e2e e2e:arc",
    "broker:setup": "pnpm --filter @xorv/broker run setup",
    "fork": "bash scripts/arc-fork.sh",
    "deploy:testnet": "bash scripts/deploy.sh testnet",
    "deploy:mainnet": "bash scripts/deploy.sh mainnet",
    "test:contracts": "cd contracts && forge test"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "usdc",
    "erc-8004",
    "cctp",
    "circle-gateway",
    "chainlink-ccip",
    "ai-agents",
    "micropayments",
    "escrow",
    "claude-code",
    "privy",
    "envio",
    "agentic-payments"
  ]
}
