{
  "name": "@xorv/contracts-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "Xorv on Arc: XorvEscrow, XorvReputation (ERC-8004), and the Chainlink CCIP sender/receiver. Foundry project; npm only supplies the Chainlink packages and the OpenZeppelin versions they import by path.",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:fork": "ARC_FORK_TESTS=1 forge test --match-path 'test/fork/*'",
    "abi": "forge build && node scripts/export-abi.mjs"
  },
  "devDependencies": {
    "@chainlink/contracts": "1.5.0",
    "@chainlink/contracts-ccip": "2.0.0",
    "@chainlink/local": "0.3.1",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@4.8.3",
    "@openzeppelin/contracts-5.3.0": "npm:@openzeppelin/contracts@5.3.0"
  }
}
