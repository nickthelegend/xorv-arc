# ---------------------------------------------------------------------------
# Xorv on Arc — copy to .env and fill in. NEVER commit .env.
#
# Who reads this file:
#   - the broker (services/broker loads <repo>/.env on start)
#   - docker compose (fills the ${…} values in docker-compose.yml from it)
# Who doesn't: the CLI, the MCP server and the MetaMask plugin read only
# their own process environment (shell exports, or the MCP client's "env"
# block) — their sections at the bottom are commented out for that reason.
# The deploy script (scripts/deploy.sh) reads its own env (see MAINNET.md).
# The frontends have their own files: apps/app/.env.example and
# apps/landing/.env.example. The indexer: services/indexer/.env.example.
#
# Arc pays gas in USDC: every key below needs a little USDC and nothing else
# (testnet faucet https://faucet.circle.com, pick "Arc Testnet"). Buyers hold
# USDC only and never send a transaction. `pnpm --filter @xorv/broker setup`
# reports what you have and prints what's missing.
# ---------------------------------------------------------------------------

# --- Network ----------------------------------------------------------------
# CAIP-2, as x402 puts it on the wire: eip155:5042002 (Arc testnet, default)
# or eip155:5042 (Arc mainnet). Anything else fails at boot. The CLI buyer and
# the MCP server honour it too.
XORV_NETWORK=eip155:5042002
# Optional private RPC (or a local Arc fork). Public: https://rpc.testnet.arc.io
# (eth_getLogs capped at 10,000 blocks) / https://rpc.mainnet.arc.io.
XORV_RPC_URL=
# Optional explorer override (default Blockscout https://explorer.testnet.arc.io).
XORV_EXPLORER_URL=

# --- Broker keys (raw secp256k1 hex, 0x optional) ---------------------------
# Make new EVM keys with `pnpm --filter @xorv/broker setup -- --new-keys`.
#
# The broker's own EOA: XorvLedger writes (registrations, sampled heartbeats,
# batched receipts), rating relays, Circle Gateway mints and (unless
# XORV_VERIFIER_KEY is set) the Kimi verifier's ERC-8004 feedback. Its address
# is XORV_BROKER_ADDRESS at deploy time (XorvLedger's broker). Unset = read-only.
XORV_OPERATOR_KEY=
# The EOA that submits buyers' EIP-3009 USDC authorizations and pays their gas
# (USDC). It must be XorvEscrow's attester (the deploy sets the attester to
# XORV_BROKER_ADDRESS, so by default this is the operator key). Defaults to the
# operator key.
XORV_FACILITATOR_KEY=

# --- x402 facilitator ---------------------------------------------------------
# self   = in-process, signs with XORV_FACILITATOR_KEY (the default: there is no
#          public x402 facilitator for Arc, and only the escrow's attester can fund it)
# <url>  = any other x402 v2 facilitator that supports this network
XORV_FACILITATOR=

# --- Arc Memo ------------------------------------------------------------------
# Every escrow fund/release/refund and every x402 transfer goes through Arc's
# Memo predeploy (0x5294E9927c3306DcBaDb03fe70b92e01cCede505) tagged with the
# job id. Set to "off" only on a chain without the Memo predeploy.
# XORV_MEMO=on

# --- Contracts (deployments/arc-<network>.json, written by scripts/deploy.sh) --
# XorvLedger: receipts and buyer ratings. Unset = no on-chain receipts.
XORV_LEDGER_ADDRESS=
# The deploy block: the floor for RPC log scans (and the keeper's first scan).
XORV_LEDGER_FROM_BLOCK=
# Publish one provider heartbeat in this many (0 = never).
XORV_HEARTBEAT_PUBLISH_EVERY=20
# Receipts are batched into one recordJobs call: sent after this many ms, or
# as soon as XORV_RECEIPT_BATCH_MAX are waiting.
XORV_RECEIPT_BATCH_MS=4000
XORV_RECEIPT_BATCH_MAX=20
# XorvEscrow. With it (and the self-hosted facilitator) the 402 offers the
# `escrow` scheme first: the buyer's USDC waits in XorvEscrow until the job
# delivers (released to the provider) or fails/expires (refunded).
XORV_ESCROW_ADDRESS=
# Seconds a funded job has before anyone may refund it (default 1800, min 120).
XORV_ESCROW_DEADLINE_S=
# XorvReputation: escrow settlements written to ERC-8004 (the router's
# escrow_outcomes tool and the provider page read it).
XORV_REPUTATION_ADDRESS=
# XorvCcipReceiver: jobs posted from Base / Ethereum over Chainlink CCIP
# (quotes with payVia "ccip"). Unset = no cross-chain jobs.
XORV_CCIP_RECEIVER_ADDRESS=
# Known XorvCcipSender contracts, shown in CCIP quotes: "84532:0x…,11155111:0x…".
XORV_CCIP_SENDERS=
# Escrow deadline for CCIP-funded quotes (CCIP waits for source finality), default 7200.
XORV_CCIP_DEADLINE_S=

# --- Refund keeper ---------------------------------------------------------------
# The broker follows every JobFunded and refunds escrowed jobs past their
# deadline (Chainlink CRE is not available on Arc mainnet, so the broker does it). Anyone
# may refund after the deadline; the keeper key must NOT be the attester, or the
# refund would count against the provider. Defaults to the operator key.
XORV_KEEPER=on
XORV_KEEPER_KEY=

# --- Broker HTTP --------------------------------------------------------------
XORV_BROKER_PORT=8402
# The broker's public base URL. It is baked into on-chain strings — ERC-8004
# agent URIs (/agents/<id>.json), rating feedback URIs (/feedback/<job>.json)
# and verifier feedback URIs (/verifications/<job>.json) — so in any real
# deployment it must be the https URL the internet reaches, not localhost.
XORV_PUBLIC_URL=http://localhost:8402
# Where clients find the broker: the CLI, the MCP server, the MetaMask plugin
# and the app's server routes read it; the broker itself uses it only as the
# fallback for XORV_PUBLIC_URL.
XORV_BROKER_URL=http://localhost:8402
# The web app, for the "web" service in agent registration files.
XORV_APP_URL=http://localhost:3002
# Comma-separated origins allowed to call the broker from a browser: the app
# (payments, ratings) and the landing (its live ledger). Replace the Vercel
# ones with your own deployments' origins.
XORV_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://xorv-app.vercel.app,https://xorv.vercel.app
# Behind a reverse proxy, set to 1 so rate limiting sees real client IPs.
XORV_TRUST_PROXY=0
# How many proxies in front of the broker append to X-Forwarded-For (only read
# with XORV_TRUST_PROXY=1). The client address is taken that many entries from
# the right, since everything to its left is whatever the client sent.
XORV_TRUSTED_HOPS=1
# Protocol fee in basis points. Display only: /api/network reports it, but
# payments go straight to the provider, so charging one needs a splitter.
XORV_FEE_BPS=0
# SQLite file for jobs, lifetime earnings and private-job vaults ("off" =
# memory only). Default <repo>/data/xorv-arc.db; the Docker image sets
# /data/xorv-arc.db. Left commented so an empty value can't override the
# image's path when this file is passed with `docker run --env-file`.
# XORV_DB=

# --- Envio indexer (services/indexer) ----------------------------------------
# Hasura GraphQL endpoint of the HyperIndex deployment, e.g.
# https://indexer.dev.hyperindex.xyz/<id>/v1/graphql. When set, the broker's
# /api/ledger, /api/receipts and /api/leaderboard read it first and fall back
# to RPC scans when it is down. The indexer's own settings (ENVIO_*) are in
# services/indexer/.env.example.
XORV_INDEXER_URL=

# --- AI roles: Hunyuan screens, Qwen routes, Kimi verifies -----------------
# Three sponsor models take a turn on every job (services/broker/src/ai/):
#   Hunyuan hy4 (Tencent TokenHub)   screens each prompt before a quote exists,
#                                    for abuse aimed at provider machines
#                                    (key theft, malware, destructive commands,
#                                    sandbox escape, prompt injection). A block
#                                    is a 422 and no quote is issued.
#   Qwen 3.8 Max (Alibaba)           routes "Auto" jobs: picks the adapter from
#                                    the live candidates under the buyer's
#                                    ceiling; the price matcher picks the node.
#   Kimi K3 (Moonshot)               scores each completed, non-private result
#                                    0-100 and writes it to the ERC-8004
#                                    Reputation Registry (tag "xorv-verified").
# Each switch: auto (default — on exactly when its key below is set), the
# provider name (on; warns at boot if the key is missing), or off. A role that
# is down or slow never blocks a job: the router and verifier fall back to the
# plain matcher / no score, and /api/network → aiRoles says why a role is off.
XORV_SCREENER=auto
XORV_ROUTER=auto
XORV_VERIFIER=auto
# When the screen can't answer (timeout, provider error, bad output):
# open = quote anyway, recorded on the job as "not screened" (default);
# closed = refuse to quote until the screen is back.
XORV_SCREENER_FAIL=open
# The EOA that signs Kimi's ERC-8004 giveFeedback (a fraction of a cent of USDC per verified job).
# Defaults to XORV_OPERATOR_KEY. It must never own or operate a provider's
# agent NFT: the Reputation Registry refuses self-feedback. If you set a
# separate key, add its address to the indexer's ENVIO_XORV_VERIFIER_ADDRESSES
# (services/indexer/.env) so Envio classifies its scores as XORV_VERIFIED —
# the indexer only trusts the ledger's broker EOA by default. Feedback files
# are served at XORV_PUBLIC_URL/verifications/<jobId>.json, so that URL must
# be public for the on-chain feedbackURI to resolve.
XORV_VERIFIER_KEY=
# Keys for the sponsor models (also read by the CLI's qwen / kimi / hunyuan /
# qwen-code provider adapters). They are sent only to each preset's own
# endpoint, never logged or served. Qwen: Alibaba Model Studio, international
# region (keys are region-bound). Kimi: platform.kimi.ai. Hunyuan:
# console.tencentcloud.com/tokenhub/apikey (activate hy4-preview in the Model
# Gallery first).
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
TOKENHUB_API_KEY=
# Optional overrides, per preset: XORV_{QWEN,KIMI,HUNYUAN}_API_KEY (take
# precedence over the keys above), _BASE_URL and _MODEL. Defaults:
#   qwen    https://dashscope-intl.aliyuncs.com/compatible-mode/v1  qwen3.8-max
#   kimi    https://api.moonshot.ai/v1                               kimi-k3
#   hunyuan https://tokenhub-intl.tencentcloudmaas.com/v1            hy4-preview

# --- Demo parties (scripts only; a real buyer signs in the browser) ---------
# `pnpm usdc` checks their balances. The buyer needs USDC only
# (https://faucet.circle.com, pick Arc Testnet) — on Arc that is also gas. Either party can
# be given as _KEY or _ADDRESS (XORV_DEMO_PAYER_ADDRESS, XORV_DEMO_PROVIDER_KEY).
# The app's "Pay from demo account" reads its own XORV_DEMO_PAYER_KEY from
# apps/app/.env.local, not this one.
XORV_DEMO_PAYER_KEY=
XORV_DEMO_PROVIDER_ADDRESS=

# --- MongoDB (optional) -------------------------------------------------------
# When set, Mongo is the restore source on boot and SQLite is the write
# guarantee: every job is written to disk synchronously and mirrored to Mongo
# in the background, so an outage can never fail a job that was already paid
# for. With docker compose: XORV_MONGO_URI=mongodb://mongo:27017 and
# `docker compose --profile mongo up`.
XORV_MONGO_URI=
XORV_MONGO_DB=xorv_arc

# --- Stablecoin override (rarely needed) --------------------------------------
# The ERC-20 the network prices in. Defaults to Circle USDC on Arc
# (0x3600000000000000000000000000000000000000 on both networks, which is also
# the gas token), EIP-712 domain "USDC" / "2". An override must support
# EIP-3009; its EIP-712 name/version must match the token exactly or every
# signed payment is rejected.
XORV_STABLECOIN=
XORV_STABLECOIN_NAME=
XORV_STABLECOIN_VERSION=

# --- CLI: provider node and buyer (packages/cli) — shell environment --------
# Also uses XORV_BROKER_URL, XORV_NETWORK, XORV_RPC_URL and the sponsor-model
# keys above.
# Where the node keeps config.json, its key and the earnings log (~/.xorv).
# XORV_HOME=
# The node's payout key, instead of the one in config.json (needed for
# `xorv identity register`; also the buyer key when XORV_PAYER_KEY is unset).
# XORV_PRIVATE_KEY=
# A dedicated buyer key for `xorv run` (USDC only; it never sends a transaction).
# XORV_PAYER_KEY=
# 1 = no tools for any adapter: text generation only.
# XORV_SAFE_MODE=1
# Force a containment tier: none, env, limits, seatbelt, bwrap or container.
# XORV_SANDBOX=container
# The container tier's image (node:24-slim) and docker network (bridge).
# XORV_SANDBOX_IMAGE=
# XORV_SANDBOX_NETWORK=
# Paths to the agent CLIs when they aren't on PATH.
# XORV_CLAUDE_BIN=  XORV_CODEX_BIN=  XORV_GROK_BIN=  XORV_OPENCODE_BIN=  XORV_QWEN_CODE_BIN=
# The openai-compatible adapter (default http://localhost:11434/v1, llama3.1).
# XORV_OPENAI_BASE_URL=
# XORV_OPENAI_API_KEY=
# XORV_OPENAI_MODEL=
# Claude Code identity to rent out, instead of the signed-in session's.
# CLAUDE_CODE_OAUTH_TOKEN=
# Grok's key; `xorv doctor` checks for it (GROK_API_KEY also counts).
# XAI_API_KEY=
# Print stack traces on errors.
# XORV_DEBUG=1

# --- MCP server (packages/mcp) — the MCP client's "env" block --------------
# Also uses XORV_BROKER_URL and XORV_NETWORK. `pnpm privy:setup` prints the
# Privy lines ready to paste; it reads XORV_PRIVY_APP_ID / _APP_SECRET (or
# PRIVY_APP_ID / PRIVY_APP_SECRET) from the shell.
# Hard ceiling per job in USD (default 0.05; XORV_MAX_USD, the old name, works).
# XORV_MAX_PRICE=0.05
# Cumulative ceiling per server process in USD (default 0.50, or "unlimited").
# XORV_SESSION_BUDGET_USD=0.50
# Local payer: XORV_PRIVATE_KEY or XORV_PAYER_KEY, as for the CLI above (a
# 0x key holding USDC on Arc). With both a local key and Privy set, pick one:
# XORV_SIGNER=local|privy
# Privy server-wallet payer (policy-bounded).
# XORV_PRIVY_APP_ID=
# XORV_PRIVY_APP_SECRET=
# XORV_PRIVY_WALLET_ID=
# Owner key, only when the wallet was created with --owner-key.
# XORV_PRIVY_AUTH_KEY=
